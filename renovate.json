{
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "semanticCommits": "enabled",
  "patch": {
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Keep Android build fallbacks at the Flutter 3.44 floor; host apps choose their own AGP and KGP",
      "matchManagers": ["gradle"],
      "matchFileNames": ["nfc_manager_android/android/build.gradle.kts"],
      "matchPackageNames": [
        "com.android.tools.build:gradle",
        "org.jetbrains.kotlin:kotlin-gradle-plugin"
      ],
      "enabled": false
    }
  ],
  "schedule": [
    "before 5am on monday"
  ],
  "timezone": "Europe/Berlin",
  "lockFileMaintenance": {
    "enabled": true
  },
  "rebaseWhen": "conflicted"
}
